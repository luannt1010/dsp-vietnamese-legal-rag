# Only public frontend configuration. Never put backend credentials here.
# Empty = same-origin /api and /health (recommended with the Vite proxy).
VITE_API_BASE_URL=
# Client deadline in milliseconds. Keep above pipeline.timeout_s + a buffer.
VITE_API_TIMEOUT_MS=300000
# Vite dev/preview proxy only; this value is not included in the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:8000
