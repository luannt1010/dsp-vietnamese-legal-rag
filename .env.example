# Reference only. load_settings() reads process environment, NOT this file.
# PowerShell: $env:RAG__RETRIEVAL__TOP_K = '8'
# Have your shell/container/launcher export the variables you choose below.

# Current runtime profile. Export these selectors before starting the API.
# RAG_CONFIG_DIR=D:/dsp-vietnamese-legal-rag/configs
# RAG_ENV_FILE=D:/dsp-vietnamese-legal-rag/.env
# RAG__APP__ENVIRONMENT=development
# RAG__RETRIEVAL__TOP_K=5
# RAG__RETRIEVAL__CANDIDATE_K=20
# RAG__LLM__PROVIDER=openai
# RAG__LLM__API_KEY=replace-with-your-secret
# RAG__EMBEDDING__API_KEY=replace-with-your-secret
# RAG__DATABASE__VECTOR__PASSWORD=replace-with-your-secret
# RAG__DATABASE__GRAPH__PASSWORD=replace-with-your-secret
# RAG__API__CORS_ORIGINS=["http://localhost:3000"]
# RAG__API__MAX_CONCURRENT_REQUESTS=1
# Explicit selectors above use the root configs/ and .env instead of legacy defaults.

# The database launcher generates .runtime/demo.env with random credentials.
# For a first setup, copy those credentials to root .env without overwriting
# credentials already used by existing databases. CLI utility invocation:
# python -m scripts.demo --config-dir configs --env-file .env doctor
# RAG__DATABASE__VECTOR__PORT=15432
# RAG__DATABASE__GRAPH__URI=bolt://127.0.0.1:17687
# RAG__DATABASE__VECTOR__INDEX_TYPE=hnsw
# RAG__DATABASE__VECTOR__DISTANCE_METRIC=cosine
